// prisma/schema.prisma
generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (NextAuth v5) ───────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          Role      @default(ADMIN)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

// ─── Loan Inquiry ────────────────────────────────────────────
model LoanInquiry {
  id              String         @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String
  loanType        LoanType
  propertyAddress String?
  loanAmount      String
  experience      String?
  notes           String?        @db.Text
  status          SubmissionStatus @default(NEW)
  assignedTo      String?
  internalNotes   String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

enum LoanType {
  GROUND_UP
  FIX_AND_FLIP
  DSCR_RENTAL
  BRIDGE_LOAN
}

// ─── Broker Registration ─────────────────────────────────────
model BrokerRegistration {
  id             String           @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  phone          String
  company        String
  nmlsId         String?
  states         String
  monthlyVolume  String?
  products       String[]
  notes          String?          @db.Text
  status         SubmissionStatus @default(NEW)
  assignedTo     String?
  internalNotes  String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

// ─── Contact Form ─────────────────────────────────────────────
model ContactSubmission {
  id            String           @id @default(cuid())
  firstName     String
  lastName      String
  company       String?
  phone         String
  email         String
  message       String           @db.Text
  status        SubmissionStatus @default(NEW)
  assignedTo    String?
  internalNotes String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ─── Careers / Job Applications ──────────────────────────────
model JobApplication {
  id            String           @id @default(cuid())
  firstName     String
  lastName      String
  email         String
  phone         String?
  position      String
  aboutText     String?          @db.Text
  resumeUrl     String?
  resumeName    String?
  status        ApplicationStatus @default(NEW)
  internalNotes String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([position])
}

// ─── Shared enums ─────────────────────────────────────────────
enum SubmissionStatus {
  NEW
  IN_REVIEW
  CONTACTED
  QUALIFIED
  CLOSED
  SPAM
}

enum ApplicationStatus {
  NEW
  REVIEWING
  PHONE_SCREEN
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

// ─── Site Content ──────────────────────────────────────────────
model SiteContent {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  updatedAt   DateTime @updatedAt
}